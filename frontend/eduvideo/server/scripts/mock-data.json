              {
                "text": "简单解这个方程，就能得到M的值，第一空就完成了。",
                "audio": "http://127.0.0.1:9000/eduvideo/education-ai/users/0c775bb2-6aae-4ad1-b8a1-4575dc2191ae/100caabc-2120-42b6-bcf3-0ab88b270715/question_explanation_video_gen_script_2f6db485-3f5b-47a3-80b0-20c802ded697_readable_tts_75ce75ee-9b3c-49e8-a3df-7eb50629bd1a.mp3",
                "duration": 4389
              }
