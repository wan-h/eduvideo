{
  "name": "@ask2vid/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "dev:api": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ask2vid/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1076.0",
    "@aws-sdk/lib-storage": "^3.1076.0",
    "@remotion/bundler": "catalog:",
    "@remotion/renderer": "catalog:",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-roll": "^4.0.0",
    "pino-pretty": "^13.1.3",
    "remotion": "4.0.484",
    "swagger-ui-express": "^5.0.1",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@remotion/cli": "catalog:",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/swagger-ui-express": "^4.1.8",
    "openapi3-ts": "^4.6.0",
    "prettier": "^3.9.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
