# ============================================================
# @ask2vid/server 环境变量示例
# 复制此文件为 .env，按需修改后启动服务
# ============================================================

# 服务监听端口
# 默认：3000
PORT=3000

# ============================================================
# 以下变量仅用于测试脚本 scripts/test-render.ts
# ============================================================

# 渲染服务地址，供测试脚本访问
# 默认：http://localhost:3000
RENDER_SERVER_URL=http://localhost:3000

# MinIO / S3 对象存储配置
# 本地开发时与 docker/.env 中的 STORAGE_ROOT_USER / STORAGE_ROOT_PASSWORD 保持一致
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=eduvideo
STORAGE_DOMAIN=http://localhost:9000