# ============================================================
# 公共环境变量（所有 mode 生效，可被 .env.[mode] 覆盖）
# ============================================================

# 后端服务地址（协议 + host + port）
# 留空 => 浏览器使用同源相对路径，由外层 nginx 统一代理
VITE_BASE_API=

# 后端全局 API 路径段，对应 backend 的 GLOABLE_PREFIX = "/api/{config.common.name}"
# 最终请求路径: {VITE_BASE_API}/api/{VITE_EDUAI_API_PREFIX}/eduvideo/v0/...
VITE_EDUAI_API_PREFIX=education-ai
