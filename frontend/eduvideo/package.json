{
  "name": "@ask2vid/frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "vite",
    "dev:all": "turbo run dev",
    "build": "pnpm --filter @ask2vid/shared build && tsc -b && vite build",
    "build:all": "turbo run build && tsc -b && vite build",
    "lint": "eslint .",
    "lint:all": "turbo run lint && eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:all": "turbo run format && prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --noEmit",
    "typecheck:all": "turbo run typecheck && tsc -b --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "ui": "shadcn add",
    "check:all": "pnpm format:all && pnpm typecheck:all && pnpm lint:all && pnpm build:all",
    "render:video": "tsx server/scripts/render-video.ts",
    "up:all": "pnpm up --recursive"
  },
  "dependencies": {
    "@ask2vid/shared": "workspace:*",
    "@fontsource-variable/inter": "^5.2.8",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/dnd": "^53.1.0",
    "@platejs/list-classic": "^53.0.0",
    "@platejs/markdown": "^53.2.2",
    "@platejs/math": "^53.0.0",
    "@platejs/media": "^53.1.4",
    "@platejs/resizable": "^53.0.0",
    "@platejs/selection": "^53.1.6",
    "@platejs/table": "^53.0.9",
    "@remotion/player": "catalog:",
    "@remotion/preload": "catalog:",
    "@remotion/web-renderer": "catalog:",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "3.0.0-beta.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "immer": "^11.1.8",
    "katex": "catalog:",
    "ky": "^2.0.2",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.22.0",
    "next-themes": "^0.4.6",
    "platejs": "^53.2.4",
    "radix-ui": "^1.6.0",
    "react": "catalog:",
    "react-day-picker": "^10.0.1",
    "react-dom": "catalog:",
    "react-error-boundary": "^6.1.2",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.0",
    "react-router": "^7.18.1",
    "recharts": "^3.9.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remotion": "4.0.484",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "uuid": "catalog:",
    "zod": "catalog:",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/react": "^16.3.2",
    "@types/katex": "^0.16.8",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.9",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "happy-dom": "^17.4.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "turbo": "^2.10.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  }
}
