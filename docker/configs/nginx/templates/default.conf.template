# ============================================================
# 统一入口模板: 容器启动时由官方 nginx 镜像的 envsubst 渲染为
#   /etc/nginx/conf.d/default.conf
# 挂载位置: docker/configs/nginx/templates -> /etc/nginx/templates (只读)
#
# 端口 / 地址全部取自环境变量，避免与 compose 配置产生分歧:
#   NGINX_HTTP_PORT    本入口监听端口（与宿主机发布端口一致）
#   SRV_EDU_PORT       后端 uvicorn 监听端口
#   WEB_EDUVIDEO_PORT  前端容器内 nginx 监听端口
#   STORAGE_HOST       对象存储内网地址（含端口）
#
# 路径约定:
#   /              -> web-eduvideo (静态 SPA)
#   /api/...       -> srv-education-api (保持原路径)
#   /storage/...   -> 对象存储的 eduvideo bucket (剥掉 /storage 前缀, 补 bucket)
#
# 对应配置（均以 PUBLIC_HOST + 端口变量派生）:
#   STORAGE_DOMAIN = http://<PUBLIC_HOST>:<NGINX_HTTP_PORT>/storage
#   WEB_EDUVIDEO_BASE_API=            (留空 => 前端走同源相对路径)
# ============================================================

# WebSocket / SSE 的 Connection 头处理
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${NGINX_HTTP_PORT};
    server_name _;

    # 视频上传/下载可能上百 MB
    client_max_body_size 0;

    # 健康检查
    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "OK";
    }

    # ---- 后端 API ----
    location /api/ {
        proxy_pass http://srv-education-api:${SRV_EDU_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        # 大文件上传直接透传，不在 nginx 落盘
        proxy_request_buffering off;
        # 流式响应(SSE)不被缓冲
        proxy_buffering off;
    }

    # ---- 接口文档 (FastAPI Swagger / ReDoc) ----
    location ~ ^/(docs|redoc|openapi\.json) {
        proxy_pass http://srv-education-api:${SRV_EDU_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- 对象存储: /storage/<key> => 对象存储的 eduvideo bucket ----
    location /storage/ {
        proxy_pass ${STORAGE_HOST}/eduvideo/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 视频拖动进度依赖 Range
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_read_timeout 600s;
        proxy_buffering off;
    }

    # ---- 前端 SPA ----
    location / {
        proxy_pass http://web-eduvideo:${WEB_EDUVIDEO_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}