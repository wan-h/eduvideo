# ============================================================
# docker compose 环境变量模板（取值与 backend/configs/config.prod.yaml 保持一致）
# 使用方法: cp .env.example .env，仅需补全标有「必填」的模型 API Key
# 数据库与对象存储密码已预填本地开发默认值，部署到对外环境请务必更换
# .env 内含真实密钥，已被 .gitignore 忽略，请勿提交/上传
# 注意: voice_samples / share_video_samples / home_display_info 等内容型配置
#       保留在 backend/configs/config.prod.yaml 中维护，未纳入环境变量
# ============================================================

# ---------- Postgres ----------
# postgres 镜像版本
POSTGRES_VERSION=18.3
# 数据库主机名，compose 服务名
POSTGRES_HOST=postgres
# 数据库端口（postgres 与 pgbouncer 均监听此端口，pgbouncer 对外也发布此端口）
POSTGRES_PORT=5432
# 数据库用户名
PGUSER=postgres
# 数据库密码：预填本地开发默认值（与 backend/configs/config.example.yaml 一致），生产环境请务必更换
POSTGRES_PASSWORD=Eduvideo2026
# 业务数据库名
POSTGRES_DB=education-ai
# 数据目录（容器内绝对路径）
PGDATA=/var/lib/postgresql/data
# 数据库最大连接数
POSTGRES_MAX_CONNECTIONS=100
# 共享缓冲区大小，建议为可用内存的 25%
POSTGRES_SHARED_BUFFERS=128MB
# 单个查询排序/哈希可用内存
POSTGRES_WORK_MEM=4MB
# 维护操作（建索引/VACUUM）可用内存
POSTGRES_MAINTENANCE_WORK_MEM=64MB
# 查询计划器对系统缓存的估计值
POSTGRES_EFFECTIVE_CACHE_SIZE=4096MB

# ---------- PgBouncer ----------
# pgbouncer 镜像版本
PGBOUNCER_VERSION=v1.25.1-p0
# pgbouncer 主机名，应用侧经它连接数据库
PGBOUNCER_HOST=pgbouncer
# 最大客户端连接数
PGBOUNCER_MAX_CLIENT_CONN=1000
# 连接池模式: session | transaction | statement
PGBOUNCER_POOL_MODE=transaction
# 每个 user/database 对的默认连接池大小
PGBOUNCER_DEFAULT_POOL_SIZE=20

# ---------- 对外访问地址 ----------
# 对外访问主机名/IP（不含端口，不含协议）
# 前端页面、MinIO 预签名 URL、Temporal UI 的 CORS 均以它为基准
# 本地用 localhost；部署到服务器时改为服务器地址或域名
PUBLIC_HOST=localhost

# ---------- MINIO (S3 兼容对象存储) ----------
# minio 镜像版本
STORAGE_VERSION=RELEASE.2025-10-15T17-29-55Z
# MinIO API 端口（容器内监听与宿主机发布保持一致）
# 下列地址均由 PUBLIC_HOST + 端口自动派生，无需手工同步：
#   STORAGE_HOST        = http://minio:<STORAGE_API_PORT>                 (容器内直连)
#   STORAGE_PUBLIC_HOST = http://<PUBLIC_HOST>:<STORAGE_API_PORT>        (浏览器预签名)
#   STORAGE_DOMAIN      = http://<PUBLIC_HOST>:<NGINX_HTTP_PORT>/storage (经入口 nginx)
STORAGE_API_PORT=9000
# MinIO 控制台端口（容器内监听与宿主机发布保持一致）
STORAGE_CONSOLE_PORT=9001
# MinIO root 用户名
STORAGE_ROOT_USER=admin
# MinIO root 密码：预填本地开发默认值（与 backend/configs/config.example.yaml 一致），生产环境请务必更换
STORAGE_ROOT_PASSWORD=Eduvideo2026
# 对象桶名
STORAGE_BUCKET=eduvideo

# ---------- 应用通用 ----------
# 运行环境: dev | prod，决定加载 config.dev.yaml 还是 config.prod.yaml
SERVER_ENV=prod
# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 调用大模型时图片的传入方式: url(直接传图片地址) | base64(data url，适用于大模型无法访问本地 MinIO 的场景)
LLM_IMAGE_INPUT=base64

# ============================================================
# 大模型服务配置（覆盖 config.prod.yaml 中的 base_url/api_key/model/provider）
# 规则: LLM_<配置位置>_{BASE_URL|API_KEY|MODEL|PROVIDER}，留空则沿用 YAML 中的值
# ============================================================

# 商品 - TTS 音色克隆
# 模型服务地址
LLM_TTS_CLONE_BASE_URL=https://api.minimax.cn/v1/t2a_v2
# 【必填】MiniMax API Key（敏感信息，同一厂商的 Key 可复用）
LLM_TTS_CLONE_API_KEY=
# 模型名
LLM_TTS_CLONE_MODEL=speech-2.8-turbo
# 模型供应商: aliyun | minimax
LLM_TTS_CLONE_PROVIDER=minimax
# 每个用户可克隆的音色数量上限
LLM_TTS_CLONE_LIMIT=2

# 商品 - 对话助手
# 模型服务地址
LLM_AGENT_CHAT_BASE_URL=https://api.deepseek.com
# 【必填】DeepSeek API Key（敏感信息，同一厂商的 Key 可复用）
LLM_AGENT_CHAT_API_KEY=
# 模型名
LLM_AGENT_CHAT_MODEL=deepseek-v4-flash
# 对话携带的历史轮数上限
LLM_AGENT_CHAT_HISTORY_LIMIT=10

# 商品 - 魔法棒（文本）
# 模型服务地址
LLM_MAGIC_WAND_TEXT_BASE_URL=https://api.deepseek.com
# 【必填】DeepSeek API Key（敏感信息，同一厂商的 Key 可复用）
LLM_MAGIC_WAND_TEXT_API_KEY=
# 模型名
LLM_MAGIC_WAND_TEXT_MODEL=deepseek-v4-flash
# 商品 - 魔法棒（图片）
# 模型服务地址
LLM_MAGIC_WAND_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# 【必填】阿里云百炼 API Key（敏感信息，同一厂商的 Key 可复用）
LLM_MAGIC_WAND_IMAGE_API_KEY=
# 模型名（文生图）
LLM_MAGIC_WAND_IMAGE_MODEL=wan2.6-t2i
# 模型名（图片编辑，留空则复用上面的模型）
LLM_MAGIC_WAND_IMAGE_EDIT_MODEL=wan2.6-image
# 模型供应商: openai | aliyun
LLM_MAGIC_WAND_IMAGE_PROVIDER=aliyun

# 任务 - 文档解析（MinerU）
# 模型服务地址
LLM_DOC_PARSE_BASE_URL=https://mineru.net/api/v4
# 【必填】MinerU API Key（敏感信息）
LLM_DOC_PARSE_API_KEY=
# 模型名: pipeline | vlm
LLM_DOC_PARSE_MODEL=pipeline
# 模型供应商
LLM_DOC_PARSE_PROVIDER=mineru

# 任务 - 题目提取
# 模型服务地址
LLM_QUESTION_EXTRACT_BASE_URL=https://api.deepseek.com
# 【必填】DeepSeek API Key（敏感信息，同一厂商的 Key 可复用）
LLM_QUESTION_EXTRACT_API_KEY=
# 模型名
LLM_QUESTION_EXTRACT_MODEL=deepseek-v4-flash

# 任务 - 可读性 TTS（中文/英文）
# 中文 TTS 模型服务地址
LLM_READABLE_TTS_ZH_BASE_URL=https://api.minimax.cn/v1/t2a_v2
# 【必填】MiniMax API Key（敏感信息，同一厂商的 Key 可复用）
LLM_READABLE_TTS_ZH_API_KEY=
# 中文 TTS 模型名
LLM_READABLE_TTS_ZH_MODEL=speech-2.8-turbo
# 中文 TTS 模型供应商: aliyun | minimax
LLM_READABLE_TTS_ZH_PROVIDER=minimax
# 英文 TTS 模型服务地址
LLM_READABLE_TTS_EN_BASE_URL=https://api.minimax.cn/v1/t2a_v2
# 【必填】MiniMax API Key（敏感信息，同一厂商的 Key 可复用）
LLM_READABLE_TTS_EN_API_KEY=
# 英文 TTS 模型名
LLM_READABLE_TTS_EN_MODEL=speech-2.8-turbo
# 英文 TTS 模型供应商: aliyun | minimax
LLM_READABLE_TTS_EN_PROVIDER=minimax
# 中文可读性翻译模型服务地址
LLM_READABLE_TTS_ZH_TRANSLATE_BASE_URL=https://api.deepseek.com
# 【必填】DeepSeek API Key（敏感信息，同一厂商的 Key 可复用）
LLM_READABLE_TTS_ZH_TRANSLATE_API_KEY=
# 中文可读性翻译模型名
LLM_READABLE_TTS_ZH_TRANSLATE_MODEL=deepseek-v4-flash
# LaTeX 可读性翻译模型服务地址
LLM_READABLE_TTS_LATEX_TRANSLATE_BASE_URL=https://api.deepseek.com
# 【必填】DeepSeek API Key（敏感信息，同一厂商的 Key 可复用）
LLM_READABLE_TTS_LATEX_TRANSLATE_API_KEY=
# LaTeX 可读性翻译模型名
LLM_READABLE_TTS_LATEX_TRANSLATE_MODEL=deepseek-v4-flash

# 任务 - 讲解视频脚本生成（讲义）
# 模型服务地址
LLM_VIDEO_SCRIPT_HANDOUT_BASE_URL=https://api.deepseek.com
# 【必填】DeepSeek API Key（敏感信息，同一厂商的 Key 可复用）
LLM_VIDEO_SCRIPT_HANDOUT_API_KEY=
# 模型名
LLM_VIDEO_SCRIPT_HANDOUT_MODEL=deepseek-v4-flash
# 任务 - 讲解视频脚本生成（配图）
# 模型服务地址
LLM_VIDEO_SCRIPT_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# 【必填】阿里云百炼 API Key（敏感信息，同一厂商的 Key 可复用）
LLM_VIDEO_SCRIPT_IMAGE_API_KEY=
# 模型名（文生图）
LLM_VIDEO_SCRIPT_IMAGE_MODEL=wan2.6-t2i
# 模型名（图片编辑，留空则复用上面的模型）
LLM_VIDEO_SCRIPT_IMAGE_EDIT_MODEL=wan2.6-image
# 模型供应商: openai | aliyun
LLM_VIDEO_SCRIPT_IMAGE_PROVIDER=aliyun

# 任务 - 题目解答
# 模型服务地址
LLM_QUESTION_SOLVE_BASE_URL=https://api.deepseek.com
# 【必填】DeepSeek API Key（敏感信息，同一厂商的 Key 可复用）
LLM_QUESTION_SOLVE_API_KEY=
# 模型名
LLM_QUESTION_SOLVE_MODEL=deepseek-v4-flash
# 任务 - 题目解析
# 模型服务地址
LLM_QUESTION_PARSE_BASE_URL=https://api.deepseek.com
# 【必填】DeepSeek API Key（敏感信息，同一厂商的 Key 可复用）
LLM_QUESTION_PARSE_API_KEY=
# 模型名
LLM_QUESTION_PARSE_MODEL=deepseek-v4-flash

# ============================================================
# 任务队列/并发/超时配置（覆盖 config.prod.yaml，留空则沿用 YAML 中的值）
# start_to_close_timeout 单位为分钟；concurrency 为 activity 并发数上限
# 修改任务队列名时需保证 API 与对应 worker 使用同一队列
# ============================================================
# 任务最大重试次数
TASK_MAX_RETRIES=2
# 基础任务：状态回写等通用 activity
# 单次 activity 开始到关闭的超时时间（分钟）
TASK_BASE_START_TO_CLOSE_TIMEOUT=3
# 任务队列名
TASK_BASE_TASK_QUEUE=base_task
# activity 并发数上限
TASK_BASE_CONCURRENCY=100
# 文档解析
# 超时时间（分钟）
TASK_DOC_PARSE_START_TO_CLOSE_TIMEOUT=10
# 任务队列名
TASK_DOC_PARSE_TASK_QUEUE=doc_parse
# activity 并发数上限
TASK_DOC_PARSE_CONCURRENCY=3
# 题目提取
# 超时时间（分钟）
TASK_QUESTION_EXTRACT_START_TO_CLOSE_TIMEOUT=5
# 任务队列名
TASK_QUESTION_EXTRACT_TASK_QUEUE=question_extract
# activity 并发数上限
TASK_QUESTION_EXTRACT_CONCURRENCY=3
# 可读性 TTS
# 每秒最大调度的 activity 数（TTS 限流）
TASK_READABLE_TTS_MAX_TASK_QUEUE_ACTIVITIES_PER_SECOND=0.2
# 超时时间（分钟）
TASK_READABLE_TTS_START_TO_CLOSE_TIMEOUT=3
# 普通任务队列名
TASK_READABLE_TTS_TASK_QUEUE=readable_tts
# 快速任务队列名
TASK_READABLE_TTS_FAST_TASK_QUEUE=fast_readable_tts
# activity 并发数上限
TASK_READABLE_TTS_CONCURRENCY=10
# 讲解视频脚本生成
# 超时时间（分钟）
TASK_VIDEO_SCRIPT_START_TO_CLOSE_TIMEOUT=10
# 任务队列名
TASK_VIDEO_SCRIPT_TASK_QUEUE=question_explanation_video_gen_script
# activity 并发数上限
TASK_VIDEO_SCRIPT_CONCURRENCY=3
# 讲解视频合成
# 超时时间（分钟）
TASK_VIDEO_SYNTHESIS_START_TO_CLOSE_TIMEOUT=20
# 任务队列名
TASK_VIDEO_SYNTHESIS_TASK_QUEUE=question_explanation_video_gen_synthesis
# activity 并发数上限
TASK_VIDEO_SYNTHESIS_CONCURRENCY=1
# 渲染阶段最大并发数（<=0 时按 CPU 核数自动计算）
TASK_VIDEO_SYNTHESIS_RENDER_MAX_CONCURRENCY=8
# 渲染分片并行数（<=0 时按默认 4 处理）
TASK_VIDEO_SYNTHESIS_RENDER_PARALLEL_CHUNKS=4
# 题目解答
# 超时时间（分钟）
TASK_QUESTION_SOLVE_START_TO_CLOSE_TIMEOUT=10
# 任务队列名
TASK_QUESTION_SOLVE_TASK_QUEUE=question_solve
# activity 并发数上限
TASK_QUESTION_SOLVE_CONCURRENCY=20
# 题目解析
# 超时时间（分钟）
TASK_QUESTION_PARSE_START_TO_CLOSE_TIMEOUT=3
# 任务队列名
TASK_QUESTION_PARSE_TASK_QUEUE=question_parse
# activity 并发数上限
TASK_QUESTION_PARSE_CONCURRENCY=20

# ---------- Temporal ----------
# temporal admin-tools 镜像版本
TEMPORAL_ADMINTOOLS_VERSION=1.30.1
# temporal server 镜像版本
TEMPORAL_SERVER_VERSION=1.30.1
# temporal server 主机名
TEMPORAL_SERVER_HOST=temporal-server
# temporal frontend gRPC 端口（容器内监听与宿主机发布一致，后端 / UI / admin-tools 均据此连接）
TEMPORAL_SERVER_PORT=7233
# temporal UI 镜像版本
TEMPORAL_UI_VERSION=2.34.0
# temporal UI 端口（容器内监听与宿主机发布一致）
TEMPORAL_UI_PORT=8080

# ---------- production-education（后端）----------
# 后端镜像版本（对应镜像 tag）
SRV_EDU_API_VERSION=v0.0.1
# 后端服务主机名（compose 服务名，worker 回写状态时使用）
SRV_EDU_HOST=srv-education-api
# 后端服务端口（容器内 uvicorn 监听端口，同时用于 healthcheck / TEMPORAL_TASK_UPDATE_URL / 入口 nginx 转发）
SRV_EDU_PORT=8000
# 应用侧连接的业务数据库名
SRV_EDU_DB=education-ai

# ---------- web-eduvideo（前端）----------
# 前端镜像版本（对应镜像 tag）
WEB_EDUVIDEO_VERSION=v0.0.1
# 前端容器内 nginx 监听端口（不对外发布，仅经统一入口 nginx 转发）
WEB_EDUVIDEO_PORT=80
# 前端请求的后端地址；留空 => 走同源相对路径，由 nginx 统一代理（推荐留空）
WEB_EDUVIDEO_BASE_API=
# 教育 AI 业务 API 路径前缀，需与后端 common.name 一致
WEB_EDUVIDEO_EDUAI_API_PREFIX=education-ai

# ---------- nginx（统一入口）----------
# nginx 对外 HTTP 端口（宿主机映射与容器内监听保持一致）
NGINX_HTTP_PORT=80